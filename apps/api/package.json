{
  "name": "@tonnage/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:dev": "tsx src/scripts/dev-db.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.3.0",
    "@tonnage/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "pg": "^8",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tonnage/contract-tests": "workspace:*",
    "@tonnage/mock-api": "workspace:*",
    "@types/pg": "^8",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "16.16.0-beta.19",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
