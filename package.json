{
  "name": "tonnage",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev:db": "pnpm --filter @tonnage/api run db:dev",
    "dev:api": "pnpm --filter @tonnage/api run dev",
    "db:migrate": "pnpm --filter @tonnage/api run db:migrate",
    "db:seed": "pnpm --filter @tonnage/api run db:seed",
    "lint": "node scripts/check-utf8.mjs && pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
