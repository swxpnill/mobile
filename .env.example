# Copy to apps/api/.env. `pnpm --filter @tonnage/api db:dev` prints the two database URLs.
NODE_ENV=development
PORT=3000
# Runtime connection, role tonnage_app (never an owner, never BYPASSRLS)
DATABASE_URL=postgres://tonnage_app:tonnage_app@127.0.0.1:54328/tonnage_dev
# Migrations, schema owner
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54328/tonnage_dev
# At least 32 characters
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# 'dev' is refused when NODE_ENV=production
OTP_PROVIDER=dev
DEV_OTP_CODE=123456
MIN_SUPPORTED_APP_VERSION=1.0.0
# on | off
RATE_LIMIT=on
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
